{
  "name": "@lenso/workers-runtime",
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "description": "Event-owned resource and generation boundaries for Lenso Workers hosts",
  "exports": {
    ".": "./index.mjs",
    "./host": "./host.mjs",
    "./http": "./http.mjs",
    "./runner": "./runner.mjs",
    "./clock": "./clock.mjs",
    "./build": "./build.mjs"
  },
  "files": [
    "*.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "node --check index.mjs && node --check host.mjs && node --check http.mjs && node --check runner.mjs && node --check scope.mjs && node --check clock.mjs && node --check build.mjs",
    "prepack": "npm run build",
    "smoke": "node --test test/package.test.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lenso-workers-build": "./build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-js.git",
    "directory": "packages/lenso-workers-runtime"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
