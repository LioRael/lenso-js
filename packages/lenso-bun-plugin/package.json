{
  "name": "@lenso/bun-plugin",
  "version": "0.4.2",
  "description": "Bun Plugin runtime for Lenso generated Capability providers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-js.git",
    "directory": "packages/lenso-bun-plugin"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js",
      "default": "./dist/build.js"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "import": "./dist/extract.js",
      "default": "./dist/extract.js"
    },
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js",
      "default": "./dist/authoring.js"
    },
    "./targets": {
      "types": "./dist/targets.d.ts",
      "import": "./dist/targets.js",
      "default": "./dist/targets.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && bun build src/index.ts src/authoring.ts src/targets.ts src/build.ts src/extract.ts --target=bun --format=esm --outdir=dist --entry-naming='[name].js' --external 'typescript/*' --external typescript-parser && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "smoke": "bun test test/package.test.ts",
    "test": "bun test test"
  },
  "dependencies": {
    "@lenso/contract-runtime": "0.3.1",
    "@lenso/process-protocol": "0.2.4",
    "typescript": "7.0.2",
    "typescript-parser": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.2.21"
  }
}
